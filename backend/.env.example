# Variáveis lidas pelo backend (perfil dev). Os valores abaixo já são os padrões.
DB_URL=jdbc:postgresql://localhost:5432/syncevents
DB_USER=syncevents
DB_PASSWORD=syncevents
APP_CORS_ORIGINS=http://localhost:8081,http://localhost:19006
APP_STORAGE_DIR=uploads
# Segredo do JWT (mínimo de 32 caracteres). Obrigatório fora do perfil dev:
# APP_JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# --- Produção (perfil prod; ver docs/deploy.md) ---
# SPRING_PROFILES_ACTIVE=prod
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco   (formato do Railway/Render; alternativa a DB_URL)
# APP_JWT_SECRET=...                                          (obrigatório)
# APP_STORAGE_DIR=/data/uploads                               (aponte para um volume persistente)
# APP_SEED_DEMO=true                                          (opcional: dados de demonstração)
